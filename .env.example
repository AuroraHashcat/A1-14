# 基础配置
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-here

# 数据库配置
DATABASE_URL=sqlite:///crypto_eval.db

# DeepInfra API配置
DEEPINFRA_API_KEY="GkYNWxWsPjnP5FGXCA67vzeCSHN2KFKX"
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
